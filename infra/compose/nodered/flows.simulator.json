[
  {
    "id": "sprint0-simulator-tab",
    "type": "tab",
    "label": "Sprint 0 MQTT Simulator",
    "disabled": false,
    "info": "Development-only simulated machine data. No PLC or PostgreSQL access."
  },
  {
    "id": "simulator-inject",
    "type": "inject",
    "z": "sprint0-simulator-tab",
    "name": "Publish every second",
    "props": [],
    "repeat": "1",
    "crontab": "",
    "once": true,
    "onceDelay": "1",
    "topic": "",
    "x": 170,
    "y": 100,
    "wires": [["simulator-payload"]]
  },
  {
    "id": "simulator-payload",
    "type": "function",
    "z": "sprint0-simulator-tab",
    "name": "Canonical machine.data",
    "func": "msg.topic = 'iot/v1/machines/SIM-MACHINE-01/data';\nmsg.qos = 1;\nmsg.retain = false;\nmsg.payload = {\n  eventId: crypto.randomUUID(),\n  eventType: 'machine.data',\n  schemaVersion: '1.0',\n  eventTime: new Date().toISOString(),\n  source: { service: 'nodered', machineId: 'SIM-MACHINE-01' },\n  payload: {\n    AI01: Number((20 + Math.random() * 5).toFixed(2)),\n    arranque: true\n  }\n};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 430,
    "y": 100,
    "wires": [["simulator-mqtt-out"]]
  },
  {
    "id": "simulator-mqtt-out",
    "type": "mqtt out",
    "z": "sprint0-simulator-tab",
    "name": "Local Mosquitto",
    "topic": "",
    "qos": "",
    "retain": "",
    "respTopic": "",
    "contentType": "",
    "userProps": "",
    "correl": "",
    "expiry": "",
    "broker": "simulator-broker",
    "x": 680,
    "y": 100,
    "wires": []
  },
  {
    "id": "simulator-broker",
    "type": "mqtt-broker",
    "name": "docker-mosquitto",
    "broker": "docker-mosquitto",
    "port": "1883",
    "clientid": "nodered-sprint0-simulator",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "autoUnsubscribe": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "birthMsg": {},
    "closeTopic": "",
    "closeQos": "0",
    "closePayload": "",
    "closeMsg": {},
    "willTopic": "",
    "willQos": "0",
    "willPayload": "",
    "willMsg": {}
  }
]
