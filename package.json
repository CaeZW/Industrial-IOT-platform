{
  "name": "industrial-iot-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "simulate:machine:init": "pnpm --filter @industrial-iot-platform/api simulate:machine init",
    "simulate:machine": "pnpm --filter @industrial-iot-platform/api simulate:machine",
    "simulate:device:init": "pnpm --filter @industrial-iot-platform/api simulate:device init",
    "simulate:device": "pnpm --filter @industrial-iot-platform/api simulate:device",
    "users": "pnpm --filter @industrial-iot-platform/api users",
    "users:init": "pnpm users init",
    "users:create": "pnpm users create",
    "dev:api": "pnpm --filter @industrial-iot-platform/api dev",
    "dev:web": "pnpm --filter @industrial-iot-platform/web dev",
    "lint": "eslint eslint.config.mjs scripts tests apps/api/src apps/api/test apps/api/prisma apps/api/prisma.config.ts apps/web/src packages/contracts/src --max-warnings 0",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "node --test tests/repository.test.mjs && pnpm -r --if-present test",
    "test:integration": "pnpm --filter @industrial-iot-platform/api test:integration",
    "build": "pnpm -r --if-present build",
    "db:generate": "pnpm --filter @industrial-iot-platform/api db:generate",
    "db:migrate": "pnpm --filter @industrial-iot-platform/api db:migrate",
    "db:deploy": "pnpm --filter @industrial-iot-platform/api db:deploy",
    "db:seed": "pnpm --filter @industrial-iot-platform/api db:seed",
    "infra:validate": "node scripts/validate-infrastructure.mjs",
    "infra:validate:start": "node scripts/validate-infrastructure.mjs --start"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "js-yaml": "5.4.1",
    "typescript-eslint": "8.69.0"
  }
}
