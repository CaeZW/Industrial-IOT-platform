generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["core"]
}

model Plant {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(80)
  name      String   @db.VarChar(160)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  areas     Area[]

  @@map("plants")
  @@schema("core")
}

model Area {
  id        String    @id @default(uuid()) @db.Uuid
  plantId   String    @map("plant_id") @db.Uuid
  code      String    @db.VarChar(80)
  name      String    @db.VarChar(160)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  plant     Plant     @relation(fields: [plantId], references: [id], onDelete: Restrict)
  machines  Machine[]
  devices   Device[]

  @@unique([plantId, code])
  @@index([plantId])
  @@map("areas")
  @@schema("core")
}

model Machine {
  id              String   @id @default(uuid()) @db.Uuid
  areaId          String   @map("area_id") @db.Uuid
  code            String?  @unique @db.VarChar(120)
  name            String   @db.VarChar(200)
  description     String?  @db.Text
  machineType     String?  @map("machine_type") @db.VarChar(100)
  legacyMachineId Int?     @unique @map("legacy_machine_id")
  metadata        Json     @default("{}") @db.JsonB
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  area            Area     @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@index([areaId])
  @@map("machines")
  @@schema("core")
}

model Device {
  id             String   @id @default(uuid()) @db.Uuid
  areaId         String   @map("area_id") @db.Uuid
  code           String?  @unique @db.VarChar(120)
  name           String   @db.VarChar(200)
  description    String?  @db.Text
  deviceType     String?  @map("device_type") @db.VarChar(100)
  legacyDeviceId Int?     @unique @map("legacy_device_id")
  metadata       Json     @default("{}") @db.JsonB
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  area           Area     @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@index([areaId])
  @@map("devices")
  @@schema("core")
}
