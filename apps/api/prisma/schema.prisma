generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["core", "iam", "audit", "operations"]
}

model Plant {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(80)
  name      String   @db.VarChar(160)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  areas     Area[]

  @@map("plants")
  @@schema("core")
}

model Area {
  id        String    @id @default(uuid()) @db.Uuid
  plantId   String    @map("plant_id") @db.Uuid
  code      String    @db.VarChar(80)
  name      String    @db.VarChar(160)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  plant     Plant     @relation(fields: [plantId], references: [id], onDelete: Restrict)
  machines  Machine[]
  devices   Device[]

  @@unique([plantId, code])
  @@index([plantId])
  @@map("areas")
  @@schema("core")
}

model Machine {
  manualOperations ManualOperation[]
  runs MachineRun[]
  data ProcessData[]
  ingestionState MachineIngestionState?
  persistenceIntervalSeconds Int @default(300) @map("persistence_interval_seconds")
  runningKey String @default("en_marcha") @map("running_key") @db.VarChar(120)
  registrationMode String @default("AUTOMATIC") @map("registration_mode") @db.VarChar(20)
  manualFormDefinition Json @default("[]") @map("manual_form_definition") @db.JsonB
  id              String   @id @default(uuid()) @db.Uuid
  areaId          String   @map("area_id") @db.Uuid
  code            String?  @unique @db.VarChar(120)
  name            String   @db.VarChar(200)
  description     String?  @db.Text
  machineType     String?  @map("machine_type") @db.VarChar(100)
  legacyMachineId Int?     @unique @map("legacy_machine_id")
  metadata        Json     @default("{}") @db.JsonB
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  area            Area     @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@index([areaId])
  @@map("machines")
  @@schema("core")
}

model Device {
  data DeviceData[]
  ingestionState DeviceIngestionState?
  persistenceIntervalSeconds Int @default(300) @map("persistence_interval_seconds")
  id             String   @id @default(uuid()) @db.Uuid
  areaId         String   @map("area_id") @db.Uuid
  code           String?  @unique @db.VarChar(120)
  name           String   @db.VarChar(200)
  description    String?  @db.Text
  deviceType     String?  @map("device_type") @db.VarChar(100)
  legacyDeviceId Int?     @unique @map("legacy_device_id")
  metadata       Json     @default("{}") @db.JsonB
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  area           Area     @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@index([areaId])
  @@map("devices")
  @@schema("core")
}

model DeviceData {
  id String @id @default(uuid()) @db.Uuid
  deviceId String @map("device_id") @db.Uuid
  eventId String @map("event_id") @db.Uuid
  eventTime DateTime @map("event_time") @db.Timestamptz(3)
  receivedAt DateTime @map("received_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  sourceType String @map("source_type") @db.VarChar(20)
  readings Json @db.JsonB
  device Device @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  @@unique([deviceId, eventId])
  @@index([deviceId, eventTime(sort: Desc), id(sort: Desc)])
  @@map("device_data")
  @@schema("operations")
}

model DeviceIngestionState {
  deviceId String @id @map("device_id") @db.Uuid
  lastEventId String @map("last_event_id") @db.Uuid
  lastEventTime DateTime @map("last_event_time") @db.Timestamptz(3)
  lastPersistedAt DateTime @map("last_persisted_at") @db.Timestamptz(3)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  @@map("device_ingestion_state")
  @@schema("operations")
}

model MachineRun {
  origin String @default("AUTOMATIC") @db.VarChar(20)
  startedById String? @map("started_by_id") @db.Uuid
  closedById String? @map("closed_by_id") @db.Uuid
  startedBy User? @relation("RunStarter", fields: [startedById], references: [id], onDelete: Restrict)
  closedBy User? @relation("RunCloser", fields: [closedById], references: [id], onDelete: Restrict)
  id String @id @default(uuid()) @db.Uuid
  machineId String @map("machine_id") @db.Uuid
  startedAt DateTime @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
  lastHeartbeatAt DateTime @map("last_heartbeat_at") @db.Timestamptz(3)
  observerId String @map("observer_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  machine Machine @relation(fields: [machineId], references: [id], onDelete: Restrict)
  data ProcessData[]
  @@unique([id, machineId])
  @@index([machineId, startedAt(sort: Desc), id(sort: Desc)])
  @@map("machine_runs")
  @@schema("operations")
}

model ProcessData {
  recordedById String? @map("recorded_by_id") @db.Uuid
  recordedBy User? @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  id String @id @default(uuid()) @db.Uuid
  machineId String @map("machine_id") @db.Uuid
  machineRunId String? @map("machine_run_id") @db.Uuid
  eventId String @map("event_id") @db.Uuid
  eventTime DateTime @map("event_time") @db.Timestamptz(3)
  receivedAt DateTime @map("received_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  sourceType String @map("source_type") @db.VarChar(20)
  readings Json @db.JsonB
  machine Machine @relation(fields: [machineId], references: [id], onDelete: Restrict)
  run MachineRun? @relation(fields: [machineRunId, machineId], references: [id, machineId], onDelete: Restrict)
  @@unique([machineId, eventId])
  @@index([machineRunId, eventTime(sort: Desc), id(sort: Desc)])
  @@index([machineId, eventTime(sort: Desc), id(sort: Desc)])
  @@map("process_data")
  @@schema("operations")
}

model MachineIngestionState {
  machineId String @id @map("machine_id") @db.Uuid
  lastEventId String @map("last_event_id") @db.Uuid
  lastEventTime DateTime @map("last_event_time") @db.Timestamptz(3)
  lastPersistedAt DateTime? @map("last_persisted_at") @db.Timestamptz(3)
  machine Machine @relation(fields: [machineId], references: [id], onDelete: Restrict)
  @@map("machine_ingestion_state")
  @@schema("operations")
}

model User {
  startedRuns MachineRun[] @relation("RunStarter")
  closedRuns MachineRun[] @relation("RunCloser")
  manualReadings ProcessData[]
  manualOperations ManualOperation[]
  id                 String      @id @default(uuid()) @db.Uuid
  username           String      @unique @db.VarChar(64)
  name               String      @db.VarChar(160)
  email              String?     @db.VarChar(254)
  passwordHash       String      @map("password_hash") @db.Text
  mustChangePassword Boolean     @default(true) @map("must_change_password")
  isActive           Boolean     @default(true) @map("is_active")
  securityVersion    Int         @default(0) @map("security_version")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  roles              UserRole[]
  scopes             UserScope[]
  sessions           Session[]

  @@map("users")
  @@schema("iam")
}

model ManualOperation {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  machineId String @map("machine_id") @db.Uuid
  key String @db.Uuid
  fingerprint String @db.VarChar(64)
  response Json @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  machine Machine @relation(fields: [machineId], references: [id], onDelete: Restrict)
  @@unique([userId, machineId, key])
  @@map("manual_operations")
  @@schema("operations")
}

model Role {
  code        String           @id @db.VarChar(64)
  name        String           @db.VarChar(100)
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
  @@schema("iam")
}

model Permission {
  code  String           @id @db.VarChar(100)
  roles RolePermission[]

  @@map("permissions")
  @@schema("iam")
}

model UserRole {
  userId   String @map("user_id") @db.Uuid
  roleCode String @map("role_code") @db.VarChar(64)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role   @relation(fields: [roleCode], references: [code], onDelete: Restrict)

  @@id([userId, roleCode])
  @@map("user_roles")
  @@schema("iam")
}

model RolePermission {
  roleCode       String     @map("role_code") @db.VarChar(64)
  permissionCode String     @map("permission_code") @db.VarChar(100)
  role           Role       @relation(fields: [roleCode], references: [code], onDelete: Cascade)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  @@id([roleCode, permissionCode])
  @@map("role_permissions")
  @@schema("iam")
}

enum ScopeType {
  PLANT
  AREA
  MACHINE
  DEVICE

  @@schema("iam")
}

model UserScope {
  userId     String    @map("user_id") @db.Uuid
  type       ScopeType
  resourceId String    @map("resource_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type, resourceId])
  @@map("user_scopes")
  @@schema("iam")
}

model Session {
  tokenHash       String   @id @map("token_hash") @db.VarChar(64)
  userId          String   @map("user_id") @db.Uuid
  securityVersion Int      @map("security_version")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(3)
  lastActivityAt  DateTime @map("last_activity_at") @db.Timestamptz(3)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
  @@schema("iam")
}

model LoginWindow {
  key       String   @id @db.VarChar(64)
  attempts  Int      @default(1)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("login_windows")
  @@schema("iam")
}

model AuditEvent {
  metadata      Json     @default("{}") @db.JsonB
  id            String   @id @default(uuid()) @db.Uuid
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  userId        String?  @map("user_id") @db.Uuid
  actor         String   @db.VarChar(160)
  action        String   @db.VarChar(100)
  resourceType  String   @map("resource_type") @db.VarChar(64)
  resourceId    String?  @map("resource_id") @db.VarChar(100)
  result        String   @db.VarChar(32)
  reason        String   @db.VarChar(160)
  sourceIp      String?  @map("source_ip") @db.VarChar(64)
  userAgent     String?  @map("user_agent") @db.VarChar(300)
  correlationId String   @map("correlation_id") @db.Uuid

  @@index([occurredAt(sort: Desc)])
  @@index([userId, occurredAt(sort: Desc)])
  @@map("audit_events")
  @@schema("audit")
}
